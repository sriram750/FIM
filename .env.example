# ===================================================
# FIM ENTERPRISE — ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================

# Platform Environment
ENVIRONMENT=production
DEBUG=false
APP_NAME="FIM Enterprise"
APP_VERSION=1.0.0
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SECRET_KEY=generate_a_secure_random_64_char_hex_key_here
API_V1_STR=/api/v1

# Security & CORS
CORS_ORIGINS=["https://fim.internal.local","http://localhost:5173","http://localhost:3000","http://localhost:8080"]
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENROLLMENT_TOKEN_SECRET=generate_enrollment_token_secret_here

# PostgreSQL Database
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=fim_admin
POSTGRES_PASSWORD=change_this_postgres_secure_password
POSTGRES_DB=fim_enterprise
DATABASE_URL=postgresql+asyncpg://fim_admin:change_this_postgres_secure_password@postgres:5432/fim_enterprise
DATABASE_SYNC_URL=postgresql+psycopg2://fim_admin:change_this_postgres_secure_password@postgres:5432/fim_enterprise

# Redis Streams & Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_this_redis_secure_password
REDIS_STREAM_KEY=fim:events:incoming
REDIS_GROUP_NAME=fim-workers
REDIS_CONSUMER_NAME=worker-1

# OpenSearch Analytics
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=change_this_opensearch_secure_password
OPENSEARCH_USE_SSL=false
OPENSEARCH_INDEX_PREFIX=fim-events

# Reverse Proxy (Nginx)
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
DOMAIN_NAME=fim.local

# Default Administrative Bootstrap (Created on initial migration if empty)
INITIAL_ADMIN_EMAIL=admin@fim.local
INITIAL_ADMIN_PASSWORD=change_initial_admin_password_on_first_login
INITIAL_ADMIN_NAME="Security Administrator"
